# Clerk (Dashboard → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Required for emailed Clerk invitations. Use the HTTPS origin only: no path,
# query string, or credentials.
CLERK_INVITATION_REDIRECT_ORIGIN=https://your-app.example.com

# Playwright smoke (optional — authenticated tests skip without these)
# E2E_CLERK_FAMILY_EMAIL=
# E2E_CLERK_FAMILY_PASSWORD=
# E2E_CLERK_STAFF_EMAIL=
# E2E_CLERK_STAFF_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_token_here...

# Stripe (Dashboard → Developers → API keys). Use test keys locally.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Developers → Webhooks → Signing secret (server-only).
STRIPE_WEBHOOK_SECRET=whsec_...
# Random server-only secret for the scheduler that invokes due-collection.
BILLING_JOB_SECRET=replace-with-a-long-random-value

# Supabase Postgres connection string (Settings → Database)
# Prefer the pooler URI for the Next.js server.
# NEVER prefix this with NEXT_PUBLIC_
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
