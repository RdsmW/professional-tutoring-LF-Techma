{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. Extracted from the Professional Tutoring style reference (DESIGN-tutoring) and the approved staff-dashboard mockup. Light mode is the source-faithful Staff palette; dark mode is DERIVED (the source ships light only).",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f6f3", "$description": "Canvas — warm linen off-white page background" },
      "foreground": { "$value": "#172133", "$description": "Ink — primary text" },
      "border": { "$value": "#e3e6e2", "$description": "Line — universal hairline separator" },
      "card": { "$value": "#ffffff", "$description": "Paper — card surface" },
      "cardForeground": { "$value": "#172133" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#172133" },
      "primary": {
        "$value": "#010345",
        "$description": "Midnight Navy — the single filled CTA color, sidebar wall, brand weight"
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e8e9f2", "$description": "Navy Soft — light navy wash, avatar fill, selected tints" },
      "secondaryForeground": { "$value": "#010345" },
      "muted": { "$value": "#fbfcfa", "$description": "Surface Lift — hover fills and muted washes" },
      "mutedForeground": { "$value": "#697486", "$description": "Slate — muted body text and metadata" },
      "accent": { "$value": "#fff6e5", "$description": "Gold Soft — gold-tinted highlight wash; gold is wayfinding, never a large fill" },
      "accentForeground": { "$value": "#8e661f", "$description": "Gold ink for text on Gold Soft" },
      "destructive": { "$value": "#ff0033", "$description": "Alert Red — destructive confirmations only" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e3e6e2" },
      "ring": { "$value": "#c4922e", "$description": "Signal Gold focus ring — gold as wayfinding" },
      "chart1": { "$value": "#010345", "$description": "Midnight Navy" },
      "chart2": { "$value": "#5a9d88", "$description": "Mint" },
      "chart3": { "$value": "#c4922e", "$description": "Signal Gold" },
      "chart4": { "$value": "#4c78a8", "$description": "Harbor" },
      "chart5": { "$value": "#7566a8", "$description": "Violet" },
      "sidebar": { "$value": "#010345", "$description": "Midnight Navy brand wall" },
      "sidebarForeground": { "$value": "#b8c4d1", "$description": "Chrome Label" },
      "sidebarBorder": { "$value": "#1a2068" },
      "sidebarPrimary": { "$value": "#1a2068", "$description": "Navy Lift — active nav well" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#1a2068", "$description": "Navy Lift — hover well" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#d8a840", "$description": "Bright Gold" }
    },
    "dark": {
      "background": { "$value": "#0b0d1f", "$description": "DERIVED — deep navy-tinted night canvas" },
      "foreground": { "$value": "#eceef6" },
      "border": { "$value": "#262a4d" },
      "card": { "$value": "#12152e" },
      "cardForeground": { "$value": "#eceef6" },
      "popover": { "$value": "#12152e" },
      "popoverForeground": { "$value": "#eceef6" },
      "primary": { "$value": "#8b93ea", "$description": "DERIVED — lifted periwinkle navy so the CTA reads on night canvas" },
      "primaryForeground": { "$value": "#05073a" },
      "secondary": { "$value": "#1c2044" },
      "secondaryForeground": { "$value": "#dfe2f5" },
      "muted": { "$value": "#171a38" },
      "mutedForeground": { "$value": "#9aa2b8" },
      "accent": { "$value": "#332a12", "$description": "DERIVED dark gold wash" },
      "accentForeground": { "$value": "#e6c26a" },
      "destructive": { "$value": "#e63757" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#262a4d" },
      "ring": { "$value": "#d8a840", "$description": "Bright Gold" },
      "chart1": { "$value": "#8b93ea" },
      "chart2": { "$value": "#6fbfa5" },
      "chart3": { "$value": "#d8a840" },
      "chart4": { "$value": "#7ba3cf" },
      "chart5": { "$value": "#9d8fd4" },
      "sidebar": { "$value": "#060830" },
      "sidebarForeground": { "$value": "#b8c4d1" },
      "sidebarBorder": { "$value": "#1a2068" },
      "sidebarPrimary": { "$value": "#1a2068" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#141850" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#d8a840" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Arial", "Helvetica", "sans-serif"],
        "$description": "Arial — the workhorse grotesque: body, nav, buttons, badges, tables"
      },
      "serif": {
        "$value": ["Georgia", "Times New Roman", "serif"],
        "$description": "Georgia — display face: page titles, section headlines, KPI numbers, wordmark. Never body copy."
      },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.875rem",
      "$description": "14px — the signature radius on cards, buttons, inputs, badges, tables. Pills and avatars use 9999px."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4px base unit; spacious density."
    }
  }
}
